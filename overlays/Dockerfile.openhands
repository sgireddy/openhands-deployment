# syntax=docker/dockerfile:1.7
#
# Hardening overlay for the OpenHands web/orchestration image.
#
# Builds a locally-tagged image (default: openhands:custom_base) on top of the
# upstream image (default: openhands:latest — built locally via `make build`
# in the OpenHands source repo) by applying OS package security upgrades and,
# optionally, a curated set of Python package upgrades inside the runtime venv.
#
# This file does NOT depend on the OpenHands source tree — it consumes a
# published image. Build context can be empty.
#
# Build:
#   docker build -f overlays/Dockerfile.openhands \
#       --build-arg BASE_IMAGE=openhands:latest \
#       -t openhands:custom_base .
#
# With Python upgrades:
#   docker build -f overlays/Dockerfile.openhands \
#       --build-arg BASE_IMAGE=openhands:latest \
#       --build-arg PIP_UPGRADES="urllib3==2.5.0 cryptography==45.0.0" \
#       -t openhands:custom_base .

ARG BASE_IMAGE=openhands:latest
FROM ${BASE_IMAGE}

ARG BASE_IMAGE
ARG PIP_UPGRADES=""

LABEL org.opencontainers.image.title="openhands-hardened" \
      org.opencontainers.image.description="Security overlay over ${BASE_IMAGE}: apt + python CVE patches." \
      org.opencontainers.image.base.name="${BASE_IMAGE}" \
      org.opencontainers.image.source="https://github.com/sgireddy/openhands-deployment"

# ---- OS package security upgrades ------------------------------------------
USER root
RUN apt-get update -y \
    && apt-get -y upgrade \
    && apt-get -y autoremove --purge \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

# ---- Distrust the emSign (eMudhra) roots -----------------------------------
# Debian blacklisted "emSign ECC Root CA - G3" in ca-certificates
# 20260816+nmu1 (bug #1151413, NMU 2026-10-20), but that upload only reached
# sid/forky. The stable suites the base images are built on still ship an
# older ca-certificates (trixie: 20250419, bookworm: 20230311+deb12u1) that
# STILL trusts the emSign roots, so `apt-get upgrade` above does NOT remove
# them.
#
# The eMudhra/emSign brand ships a FAMILY of roots in the Mozilla bundle, not
# just G3 (trixie 20250419 ships emSign Root CA - C1 / G1 and emSign ECC Root
# CA - C3 / G3). We distrust ALL of them: prefix every emSign entry in
# /etc/ca-certificates.conf with "!" and regenerate the trust store. The build
# fails if no emSign entry is found (upstream rename) or if ANY emSign link
# survives in /etc/ssl/certs after regeneration, so this can never silently
# no-op. Set KEEP_EMSIGN_ROOT=1 to opt out once Debian stable backports the
# distrust.
ARG KEEP_EMSIGN_ROOT=""
RUN if [ -z "$KEEP_EMSIGN_ROOT" ]; then \
        conf=/etc/ca-certificates.conf ; \
        n="$(grep -ciE '^mozilla/emSign' "$conf")" ; \
        echo ">>> Distrusting $n emSign (eMudhra) root(s):" ; \
        grep -iE '^mozilla/emSign' "$conf" || true ; \
        if [ "$n" -eq 0 ]; then \
            echo "ERROR: no 'mozilla/emSign*' trust entry found in $conf; emSign filenames may have changed upstream" >&2 ; exit 1 ; \
        fi \
        && sed -i -E "s@^(mozilla/emSign.*\.crt)@!\1@I" "$conf" \
        && update-ca-certificates --fresh \
        && if ls -1 /etc/ssl/certs/ | grep -qi emSign; then \
               echo "ERROR: emSign root(s) still trusted after blacklist:" >&2 ; \
               ls -1 /etc/ssl/certs/ | grep -i emSign >&2 ; exit 1 ; \
           fi \
        && echo ">>> All emSign roots successfully distrusted." ; \
    else \
        echo ">>> KEEP_EMSIGN_ROOT set; leaving emSign roots trusted." ; \
    fi

# ---- Optional: Python package upgrades inside the existing venv -----------
# The upstream image installs to /app/.venv as the "openhands" user. We honour
# that by switching users for pip operations so venv metadata stays consistent.
USER openhands
RUN if [ -n "$PIP_UPGRADES" ]; then \
        echo ">>> Upgrading Python packages: $PIP_UPGRADES" \
        && python -m pip install --no-cache-dir --upgrade $PIP_UPGRADES \
        && python -m pip cache purge >/dev/null 2>&1 || true ; \
    else \
        echo ">>> No PIP_UPGRADES specified; skipping Python upgrades." ; \
    fi

# ---- Make the Python TLS trust path eMudhra-clear --------------------------
# IMPORTANT: upgrading `certifi` to 2026.10.19 is NOT sufficient on its own.
# That release (GHSA-6q48-6c7w-9gw2) removes only the single compromised root
# "emSign ECC Root CA - G3" but STILL ships three other eMudhra-operated roots
# (emSign Root CA - G1 / C1, emSign ECC Root CA - C3). Trivy stops flagging the
# package, but every Python HTTPS client that uses certifi (litellm, requests,
# httpx, pip, ...) would keep trusting eMudhra. We distrust the WHOLE emSign
# family in the OS store, so we do the same here for consistency.
#
# strip-emsign-certifi.py removes every emSign/eMudhra record from a cacert.pem
# (idempotent; fails if any marker survives). Runs as the "openhands" user so
# `python` resolves to the /app/.venv interpreter that owns the certifi install.
# We also overwrite pip's VENDORED certifi (pip/_vendor) with the upgraded,
# stripped top-level files so its recorded version (read by Trivy) moves off the
# flagged 2026.6.17. Opt out with KEEP_EMSIGN_ROOT.
COPY overlays/strip-emsign-certifi.py /usr/local/share/strip-emsign-certifi.py
RUN if [ -z "$KEEP_EMSIGN_ROOT" ]; then \
        realdir="$(python -c 'import os,certifi; print(os.path.dirname(certifi.__file__))' 2>/dev/null || true)" ; \
        ver="$(python -c 'import importlib.metadata as m; print(m.version("certifi"))' 2>/dev/null || true)" ; \
        vend="$(python -c 'import importlib.util,os; s=importlib.util.find_spec("pip._vendor.certifi"); print(os.path.dirname(s.origin) if s and s.origin else "")' 2>/dev/null || true)" ; \
        if [ -n "$realdir" ] && [ -d "$realdir" ]; then \
            python /usr/local/share/strip-emsign-certifi.py "$realdir/cacert.pem" ; \
            if [ -n "$vend" ] && [ -d "$vend" ]; then \
                cp -a "$realdir"/. "$vend"/ \
                && rm -rf "$vend/__pycache__" \
                && echo ">>> replaced pip vendored certifi from $realdir (now $ver, incl stripped cacert.pem + __version__)" ; \
                vt="$(dirname "$vend")/vendor.txt" ; \
                if [ -n "$ver" ] && [ -f "$vt" ]; then \
                    sed -i -E "s/^([[:space:]]*)certifi==.*/\1certifi==$ver/I" "$vt" \
                    && echo ">>> updated pip vendor.txt certifi==$ver" ; \
                fi ; \
                python /usr/local/share/strip-emsign-certifi.py "$vend/cacert.pem" ; \
            else \
                echo ">>> pip has no vendored certifi; stripped top-level only." ; \
            fi ; \
        else \
            echo ">>> no top-level certifi found; skipping eMudhra strip." ; \
        fi ; \
    else \
        echo ">>> KEEP_EMSIGN_ROOT set; leaving certifi trust bundles untouched." ; \
    fi

# ---- Optional: strip unused VS Code extension build artifacts -------------
# The upstream openhands web image bundles
#   /app/openhands/integrations/vscode/
#       node_modules/                (~219 MB of npm devDeps + transitive deps)
#       out/extension.js{,.map}      (compiled output of those sources)
#       openhands-vscode-0.0.1.vsix  (the actual deliverable shipped to users)
#
# The Python web container never executes any of that JavaScript at runtime —
# the .vsix is what an end-user installs in their own VS Code, and the
# node_modules/out tree is the build sandbox left over from compiling it.
#
# Trivy / Scout still scan that build tree, so it's the source of every fixable
# npm HIGH (minimatch / undici / flatted / glob / jws / lodash / picomatch /
# serialize-javascript / tar-fs / underscore / @isaacs/brace-expansion / ...).
# Some of those advisories are graded Critical by Scout (GHSA → NVD severity
# drift, see AGENTS.md). Stripping the build sandbox removes the entire pile
# without touching the .vsix that ships to users.
#
# Set `--build-arg STRIP_VSCODE_BUILD_ARTIFACTS=1` to remove. Default keeps
# the upstream layout untouched.
USER root
ARG STRIP_VSCODE_BUILD_ARTIFACTS=""
RUN if [ -n "$STRIP_VSCODE_BUILD_ARTIFACTS" ]; then \
        VSC=/app/openhands/integrations/vscode; \
        if [ -d "$VSC" ]; then \
            echo ">>> Stripping VS Code extension build artifacts under $VSC (keeping .vsix)" \
            && rm -rf "$VSC/node_modules" "$VSC/out" ; \
        else \
            echo ">>> $VSC not found; nothing to strip." ; \
        fi ; \
    else \
        echo ">>> Keeping VS Code build artifacts (set STRIP_VSCODE_BUILD_ARTIFACTS=1 to remove)." ; \
    fi

# Match upstream runtime expectations (entrypoint runs as root, drops privs).
USER root
WORKDIR /app
