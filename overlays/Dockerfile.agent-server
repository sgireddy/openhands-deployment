# syntax=docker/dockerfile:1.7
#
# Hardening overlay for the OpenHands agent-server (sandbox runtime) image.
#
# The agent-server image is what each conversation's sandbox runs inside. It
# is published from the openhands software-agent-sdk repo, not from this
# folder. This overlay layers OS + Python security patches on top without
# touching that upstream.
#
# Build:
#   docker build -f overlays/Dockerfile.agent-server \
#       --build-arg BASE_IMAGE=ghcr.io/openhands/agent-server:1.19.0-python \
#       -t agent-server:custom_base .
#
# With Python upgrades:
#   docker build -f overlays/Dockerfile.agent-server \
#       --build-arg BASE_IMAGE=ghcr.io/openhands/agent-server:1.19.0-python \
#       --build-arg PIP_UPGRADES="urllib3==2.5.0 cryptography==45.0.0" \
#       -t agent-server:custom_base .

# Pin by DIGEST (not a floating tag) for reproducible, tamper-evident builds.
# This digest is ghcr.io/openhands/agent-server:1.58.1-python (multi-arch).
# Override BASE_IMAGE to bump; re-pin the digest when you do.
ARG BASE_IMAGE=ghcr.io/openhands/agent-server:1.58.1-python@sha256:3ec59797bc2e237c7a3bda3468f4e26bc860416949d439fe3f485798afd814bc
FROM ${BASE_IMAGE}

ARG BASE_IMAGE
ARG PIP_UPGRADES=""

LABEL org.opencontainers.image.title="agent-server-hardened" \
      org.opencontainers.image.description="Security overlay over ${BASE_IMAGE}: apt + python CVE patches." \
      org.opencontainers.image.base.name="${BASE_IMAGE}" \
      org.opencontainers.image.source="https://github.com/sgireddy/openhands-deployment"

# ---- OS package security upgrades ------------------------------------------
# The agent-server image typically runs as root to support sandbox operations
# (chrooted filesystem ops, package installs, etc.) so we don't drop privs.
USER root
RUN apt-get update -y \
    && apt-get -y upgrade \
    && apt-get -y autoremove --purge \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

# ---- Distrust the emSign (eMudhra) roots -----------------------------------
# Debian blacklisted "emSign ECC Root CA - G3" in ca-certificates
# 20260816+nmu1 (bug #1151413, NMU 2026-10-20), but that upload only reached
# sid/forky. The stable suites the base images are built on still ship an
# older ca-certificates (trixie: 20250419, bookworm: 20230311+deb12u1) that
# STILL trusts the emSign roots, so `apt-get upgrade` above does NOT remove
# them.
#
# The eMudhra/emSign brand ships a FAMILY of roots in the Mozilla bundle, not
# just G3 (trixie 20250419 ships emSign Root CA - C1 / G1 and emSign ECC Root
# CA - C3 / G3). We distrust ALL of them: prefix every emSign entry in
# /etc/ca-certificates.conf with "!" and regenerate the trust store. The build
# fails if no emSign entry is found (upstream rename) or if ANY emSign link
# survives in /etc/ssl/certs after regeneration, so this can never silently
# no-op. Set KEEP_EMSIGN_ROOT=1 to opt out once Debian stable backports the
# distrust.
ARG KEEP_EMSIGN_ROOT=""
RUN if [ -z "$KEEP_EMSIGN_ROOT" ]; then \
        conf=/etc/ca-certificates.conf ; \
        n="$(grep -ciE '^mozilla/emSign' "$conf")" ; \
        echo ">>> Distrusting $n emSign (eMudhra) root(s):" ; \
        grep -iE '^mozilla/emSign' "$conf" || true ; \
        if [ "$n" -eq 0 ]; then \
            echo "ERROR: no 'mozilla/emSign*' trust entry found in $conf; emSign filenames may have changed upstream" >&2 ; exit 1 ; \
        fi \
        && sed -i -E "s@^(mozilla/emSign.*\.crt)@!\1@I" "$conf" \
        && update-ca-certificates --fresh \
        && if ls -1 /etc/ssl/certs/ | grep -qi emSign; then \
               echo "ERROR: emSign root(s) still trusted after blacklist:" >&2 ; \
               ls -1 /etc/ssl/certs/ | grep -i emSign >&2 ; exit 1 ; \
           fi \
        && echo ">>> All emSign roots successfully distrusted." ; \
    else \
        echo ">>> KEEP_EMSIGN_ROOT set; leaving emSign roots trusted." ; \
    fi

# ---- Make `uv`'s TLS trust path eMudhra-clear ------------------------------
# uv does NOT use certifi — it verifies TLS against a copy of `webpki-root-certs`
# compiled INTO the binary (`/usr/bin/uv`, a standalone musl binary, not a pip
# package). GHSA-hq85-5cpj-mr62 removed only `emSign ECC Root CA - G3` in uv
# 0.13.4; the base's uv 0.13.5 is advisory-safe but its vendored bundle STILL
# embeds the rest of the eMudhra family (emSign ECC Root CA - C3, emSign Root CA
# - C1 / G1). A `pip install uv==x` does NOT change this binary (and would only
# shadow it with an equal-or-older pip-packaged uv), so the pin is useless here.
#
# The robust fix is `UV_NATIVE_TLS=1`: uv then verifies against the platform
# trust store (via rustls-platform-verifier) instead of its vendored bundle. We
# already stripped the ENTIRE emSign family from that OS store above, so uv
# inherits an eMudhra-clean trust set. Proven: with UV_NATIVE_TLS=1 and an empty
# OS store, uv fails `UnknownIssuer`; with the cleaned store it succeeds. Set
# KEEP_EMSIGN_ROOT=1 to opt out (keeps uv on its vendored bundle).
ENV UV_NATIVE_TLS=1
ARG UV_MIN_VERSION=0.13.4
RUN if [ -z "$KEEP_EMSIGN_ROOT" ]; then \
        uvbin="$(command -v uv || true)" ; \
        if [ -n "$uvbin" ]; then \
            uvver="$("$uvbin" --version 2>/dev/null | awk '{print $2}')" ; \
            echo ">>> uv at $uvbin (version ${uvver:-unknown}) will use native TLS (cleaned OS store)" ; \
            if grep -qi emSign /etc/ssl/certs/ca-certificates.crt 2>/dev/null; then \
                echo "ERROR: OS trust bundle still contains emSign; uv native-TLS would trust it" >&2 ; exit 1 ; \
            fi ; \
            if [ -z "$uvver" ] || [ "$(printf '%s\n%s\n' "$UV_MIN_VERSION" "$uvver" | sort -V | head -1)" != "$UV_MIN_VERSION" ]; then \
                echo "ERROR: base uv is '${uvver:-unknown}' (< $UV_MIN_VERSION); its vendored webpki bundle still trusts the compromised emSign ECC Root CA - G3 (GHSA-hq85-5cpj-mr62). Upgrade the base image's uv to >= $UV_MIN_VERSION." >&2 ; exit 1 ; \
            fi ; \
            echo ">>> uv ${uvver} is >= $UV_MIN_VERSION (GHSA-hq85-5cpj-mr62 fixed); native TLS also routes it around the residual emSign family." ; \
        else \
            echo ">>> no uv binary present; UV_NATIVE_TLS set for any later uv." ; \
        fi ; \
    else \
        echo ">>> KEEP_EMSIGN_ROOT set; leaving uv on its vendored webpki bundle." ; \
    fi

# ---- Optional: Python package upgrades -------------------------------------
# We don't assume a specific venv layout — use whichever `python` is on PATH.
RUN if [ -n "$PIP_UPGRADES" ]; then \
        echo ">>> Upgrading Python packages: $PIP_UPGRADES" \
        && python -m pip install --no-cache-dir --upgrade $PIP_UPGRADES \
        && python -m pip cache purge >/dev/null 2>&1 || true ; \
    else \
        echo ">>> No PIP_UPGRADES specified; skipping Python upgrades." ; \
    fi

# ---- Make the Python TLS trust path eMudhra-clear --------------------------
# Two things matter for certifi, and they are separate:
#   (a) the recorded VERSION that scanners (Trivy) read, and
#   (b) the actual CA bundle (`cacert.pem`) contents that TLS clients trust.
#
# For (a) we rely on UPSTREAM fixed versions rather than hand-editing metadata:
#   - top-level `certifi`: pinned to 2026.10.19 via PIP_UPGRADES.
#   - pip's VENDORED certifi (pip/_vendor/certifi, used for pip's own TLS):
#     pip >= 26.2.2 already vendors certifi 2026.10.19 with consistent
#     __version__ + vendor.txt + bom.cdx.json, so Trivy sees it as fixed. We do
#     NOT copy/rewrite those files anymore; instead PIP_UPGRADES carries
#     `pip==26.2.2` and the guard below fails the build if the vendored certifi
#     is still older than 2026.10.19 (tells you to bump pip).
#
# For (b): even certifi 2026.10.19 only drops the ONE compromised root
# "emSign ECC Root CA - G3" (GHSA-6q48-6c7w-9gw2) and STILL ships three other
# eMudhra roots (emSign Root CA - G1 / C1, emSign ECC Root CA - C3). No certifi
# version removes those, so `strip-emsign-certifi.py` strips the WHOLE emSign
# family from each cacert.pem (top-level + vendored), matching the OS-store
# distrust. This changes only cacert contents, not the version metadata.
# Opt out of everything with KEEP_EMSIGN_ROOT.
COPY overlays/strip-emsign-certifi.py /usr/local/share/strip-emsign-certifi.py
RUN if [ -z "$KEEP_EMSIGN_ROOT" ]; then \
        min="2026.10.19" ; \
        realdir="$(python -c 'import os,certifi; print(os.path.dirname(certifi.__file__))' 2>/dev/null || true)" ; \
        if [ -n "$realdir" ] && [ -d "$realdir" ]; then \
            python /usr/local/share/strip-emsign-certifi.py "$realdir/cacert.pem" ; \
        else \
            echo ">>> no top-level certifi found; skipping its eMudhra strip." ; \
        fi ; \
        vend="$(python -c 'import importlib.util,os; s=importlib.util.find_spec("pip._vendor.certifi"); print(os.path.dirname(s.origin) if s and s.origin else "")' 2>/dev/null || true)" ; \
        if [ -n "$vend" ] && [ -d "$vend" ]; then \
            vv="$(python -c 'import pip._vendor.certifi as c; print(getattr(c,"__version__",""))' 2>/dev/null || true)" ; \
            if [ -z "$vv" ] || [ "$(printf '%s\n%s\n' "$min" "$vv" | sort -V | head -1)" != "$min" ]; then \
                echo "ERROR: pip-vendored certifi is '${vv:-unknown}' (< $min); add 'pip==26.2.2' (or newer) to PIP_UPGRADES so pip vendors a fixed certifi" >&2 ; exit 1 ; \
            fi ; \
            python /usr/local/share/strip-emsign-certifi.py "$vend/cacert.pem" ; \
            echo ">>> pip-vendored certifi $vv is fixed (>= $min); emSign family stripped from its cacert." ; \
        else \
            echo ">>> pip has no vendored certifi; nothing to do for pip." ; \
        fi ; \
    else \
        echo ">>> KEEP_EMSIGN_ROOT set; leaving certifi trust bundles untouched." ; \
    fi

# ---- Remove unused openvscode-server language-only extensions --------------
# The agent-server bundles openvscode-server with built-in language extensions
# whose `package.json` names collide with vulnerable npm packages (e.g. the
# vscode-published `handlebars` extension at v1.0.0 is just TextMate grammar
# files — no template-engine code — but Trivy matches by `name+version` and
# raises CVE-2019-19919 / 2021-23369 / 2021-23383 against the npm
# `handlebars` template engine, which is a completely different package).
#
# Sandbox runtimes don't render Handlebars templates in the embedded editor,
# so removing the syntax-highlighter extension is harmless and eliminates the
# false-positive CVE rows at the source instead of via a suppression file.
#
# If you have any reason to keep these extensions, set
# `--build-arg KEEP_VSCODE_HANDLEBARS=1` and they'll be left in place.
ARG KEEP_VSCODE_HANDLEBARS=""
RUN if [ -z "$KEEP_VSCODE_HANDLEBARS" ] && [ -d /openhands/.openvscode-server/extensions/handlebars ]; then \
        echo ">>> Removing unused openvscode-server handlebars language extension (false-positive CVEs)" \
        && rm -rf /openhands/.openvscode-server/extensions/handlebars ; \
    fi

# ---- Optional: strip the embedded browser / VNC desktop stack -------------
# The upstream agent-server image bundles a full graphical stack so the
# agent's "browser" tool can drive a real Chromium and so a human operator
# can VNC-attach to watch desktop sessions. That stack pulls in a long tail
# of OS packages (chromium, Mesa GL, X11/freedesktop libs, TigerVNC, novnc,
# system Node 20). Each is a separate CVE surface — for example, as of this
# writing all three Critical CVEs left in the image come from this stack:
#
#     CVE-2026-40393  Mesa libgbm1 / libgl1-mesa-dri / libglx-mesa0 /
#                     mesa-libgallium  (transitive of chromium)
#     CVE-2026-34352  tigervnc-common / tigervnc-standalone-server
#     CVE-2026-1525   node-undici        (transitive of novnc → nodejs)
#
# If your conversations never ask the agent to "open this URL", "screenshot
# this site", "fill this form" etc. — i.e., the agent only edits code and
# runs shells — this entire stack is dead weight. Setting
# `--build-arg STRIP_BROWSER_TOOLS=1` purges it (and everything it depends
# on, via apt-get autoremove). The bundled openvscode-server keeps working
# because it ships its own Node v22 at /usr/local/bin/node, independent of
# the system Debian Node that goes away.
#
# Trade-offs documented in README.md ("Slim variant" section). To rebuild
# with browser tools later, omit the build-arg or pass STRIP_BROWSER_TOOLS=
# (empty).
ARG STRIP_BROWSER_TOOLS=""
RUN if [ -n "$STRIP_BROWSER_TOOLS" ]; then \
        echo ">>> Stripping browser/VNC stack: chromium, tigervnc, novnc, x11-utils + transitive deps" \
        && apt-get update -y \
        && apt-get purge -y --auto-remove \
            chromium chromium-common \
            tigervnc-standalone-server tigervnc-common \
            novnc \
            x11-utils \
        && apt-get clean \
        && rm -rf /var/lib/apt/lists/* /var/cache/apt/archives/* ; \
    else \
        echo ">>> Keeping browser/VNC stack (set STRIP_BROWSER_TOOLS=1 to remove)." ; \
    fi

# ---- Optional: strip the embedded docker-in-docker stack ------------------
# The upstream agent-server bundles a full Docker + containerd stack
# (containerd.io, docker-ce, docker-ce-cli, docker-buildx-plugin,
# docker-compose-plugin, docker-ce-rootless-extras, runc, rootlesskit) so
# the agent can `docker build` / `docker run` inside the sandbox during a
# conversation. That stack is the source of any Critical CVE that lives in
# `containerd` / `dockerd` / `ctr` / `runc` (Go binaries that statically
# link `google.golang.org/grpc` etc.). For example, as of this writing
# `containerd 2.2.3` (the latest version Docker has published in their apt
# feed) links `google.golang.org/grpc 1.78.0`, which Scout grades:
#
#     CVE-2026-33186  google.golang.org/grpc  v1.78.0  CVSS 9.1  CRITICAL
#
# There is currently no upstream `containerd.io` package newer than 2.2.3
# in `download.docker.com/linux/debian bookworm/stable`, so apt-upgrade
# cannot fix it. The only ways to clear it are (a) wait for upstream, or
# (b) delete the stack from the slim image entirely.
#
# Most agent deployments don't need docker-in-docker — the agent is itself
# already running inside a container managed by the host's Docker daemon.
# Setting `--build-arg STRIP_DIND=1` purges the entire DinD stack (and
# autoremoves transitive deps like `tini`, `pigz`, `iptables-persistent`,
# `slirp4netns`, etc.). The agent's filesystem ops, shell, code-edit and
# embedded openvscode-server are all unaffected.
#
# Trade-offs documented in README.md ("Slim variant" section). To rebuild
# with docker-in-docker later, omit the build-arg or pass STRIP_DIND=
# (empty).
ARG STRIP_DIND=""
RUN if [ -n "$STRIP_DIND" ]; then \
        echo ">>> Stripping docker-in-docker stack: docker-ce, containerd.io, runc, buildx, compose + transitive deps" \
        && apt-get update -y \
        && apt-get purge -y --auto-remove \
            docker-ce docker-ce-cli docker-ce-rootless-extras \
            docker-buildx-plugin docker-compose-plugin \
            containerd.io \
            runc \
        && apt-get clean \
        && rm -rf /var/lib/apt/lists/* /var/cache/apt/archives/* ; \
    else \
        echo ">>> Keeping docker-in-docker stack (set STRIP_DIND=1 to remove)." ; \
    fi

# ---- Optional: strip the C/C++ build toolchain (reaches Critical=0) ----------
# The only remaining Critical in the slim image is CVE-2026-93221 in
# `linux-libc-dev` — the Linux *kernel header* package. It has no upstream fix
# and is not runtime-exploitable in a container (the container uses the HOST
# kernel; these are just .h definitions used at compile time). Purging it
# cascades (via `libc6-dev`) to the whole toolchain: build-essential, gcc/g++,
# libc6-dev, libstdc++-dev.
#
# TRADE-OFF — default OFF on purpose: this is an AGENT SANDBOX. Agents commonly
# `pip install` packages with native extensions or compile code at runtime, which
# needs gcc/make/libc headers. Removing the toolchain to win a kernel-header CVE
# that can't be exploited in-container is usually a BAD trade. Keep it off unless
# you KNOW your workloads never compile at runtime; then set
# STRIP_BUILD_TOOLCHAIN=1 for a true Critical=0 image.
ARG STRIP_BUILD_TOOLCHAIN=""
RUN if [ -n "$STRIP_BUILD_TOOLCHAIN" ]; then \
        echo ">>> Stripping C/C++ build toolchain (build-essential, gcc/g++, libc6-dev, linux-libc-dev) — removes runtime compilation capability" \
        && apt-get update -y \
        && apt-get purge -y --auto-remove \
            linux-libc-dev libc6-dev build-essential \
            g++ gcc 'g++-*' 'gcc-*' 'libstdc++-*-dev' \
        && apt-get clean \
        && rm -rf /var/lib/apt/lists/* /var/cache/apt/archives/* ; \
        if dpkg-query -W -f='${Package}\n' linux-libc-dev >/dev/null 2>&1; then \
            echo "ERROR: linux-libc-dev still present after toolchain purge" >&2 ; exit 1 ; \
        fi ; \
        echo ">>> Build toolchain removed; linux-libc-dev gone (CVE-2026-93221 cleared)." ; \
    else \
        echo ">>> Keeping C/C++ build toolchain (set STRIP_BUILD_TOOLCHAIN=1 to remove; clears linux-libc-dev CVE-2026-93221 but disables runtime native compilation)." ; \
    fi

# ---- Replace older bundled Node 22 with the already-fixed system Node 22 --
# `/opt/acp-node/bin/node` is a copy of Node 22.14.0 that the upstream image
# bundles for the third-party Agent-Client-Protocol tools (gemini-cli,
# claude-agent-acp, codex-acp). Node 22.14.0 is affected by:
#
#     CVE-2025-55130  node  >=22.0.0 <22.22.0  CRITICAL
#
# The image already ships a fixed `/usr/local/bin/node` at v22.22.x for the
# bundled openvscode-server, so we can repoint the older copy at it instead
# of dragging in a fresh tarball. This is a no-op when the file is missing.
RUN if [ -f /opt/acp-node/bin/node ] && [ -x /usr/local/bin/node ]; then \
        bundled_ver="$(/opt/acp-node/bin/node --version 2>/dev/null || echo unknown)" ; \
        system_ver="$(/usr/local/bin/node --version 2>/dev/null || echo unknown)" ; \
        if [ "$bundled_ver" != "$system_ver" ]; then \
            echo ">>> Replacing /opt/acp-node/bin/node ($bundled_ver) with system /usr/local/bin/node ($system_ver) — clears CVE-2025-55130" \
            && rm -f /opt/acp-node/bin/node \
            && ln -s /usr/local/bin/node /opt/acp-node/bin/node ; \
        else \
            echo ">>> /opt/acp-node/bin/node already matches /usr/local/bin/node ($system_ver); no replacement needed." ; \
        fi ; \
    fi

# ---- Fix Critical CVEs in bundled npm toolchains and ACP agent CLIs --------
# A fresh Trivy scan of the slim image flagged these bundled-npm Criticals:
#
#   @google/gemini-cli 0.38.0  CVE-2026-12537  RCE via workspace-trust bypass
#                              (fixed 0.39.1) — /opt/acp-node global package
#   tar (several copies)       CVE-2026-59873  gzip-bomb DoS (fixed 7.5.19) —
#                              vendored inside each `npm` install
#   proxy-addr 2.0.7           CVE-2026-90711  IP spoofing (fixed 2.0.8) —
#                              nested under @agentclientprotocol/claude-agent-acp
#
# We fix them in place rather than stripping, because the ACP agent CLIs are a
# product feature. Updating the bundled `npm` to a version that vendors
# tar>=7.5.19 clears every `npm`-internal tar copy at once; gemini-cli is bumped
# directly; proxy-addr is refreshed best-effort in the claude-agent-acp tree.
#
# Pins (verified present on the npm registry, 2026-10-22):
#   npm 12.2.1 vendors tar ^7.5.22 (>= the 7.5.19 fix)
#   @google/gemini-cli 0.39.1 is the minimum fixed release
#
# The downstream build.sh scan gate (POLICY_MAX_CRITICAL=0) is the backstop:
# if any of these survive, the build fails there. Opt out with
# `--build-arg KEEP_BUNDLED_NPM=1`.
#   shell-quote 1.8.3         CVE-2026-9277   arbitrary code execution via
#                              command injection (fixed 1.8.4) — bundled as a
#                              leaf dep inside openvscode-server's node_modules
#
# shell-quote is a tiny pure-JS leaf package deduped deep in bundled trees, so
# we replace every copy in place with the fixed tarball (npm pack just
# downloads; it does not mutate the surrounding dependency tree).
ARG KEEP_BUNDLED_NPM=""
ARG NPM_PIN="12.2.1"
ARG GEMINI_CLI_PIN="0.39.1"
ARG PROXY_ADDR_PIN="2.0.8"
ARG SHELL_QUOTE_PIN="1.12.0"
RUN if [ -n "$KEEP_BUNDLED_NPM" ]; then \
        echo ">>> KEEP_BUNDLED_NPM set; leaving bundled npm packages untouched." ; \
    else \
        set -e ; \
        for npm_bin in /usr/local/bin/npm /opt/acp-node/bin/npm; do \
            if [ -x "$npm_bin" ]; then \
                echo ">>> Updating bundled npm at $npm_bin to $NPM_PIN (vendors tar>=7.5.19)" ; \
                "$npm_bin" install -g --no-audit --no-fund "npm@${NPM_PIN}" ; \
            fi ; \
        done ; \
        if [ -x /opt/acp-node/bin/npm ]; then \
            echo ">>> Updating @google/gemini-cli to $GEMINI_CLI_PIN (clears CVE-2026-12537 RCE)" ; \
            /opt/acp-node/bin/npm install -g --no-audit --no-fund "@google/gemini-cli@${GEMINI_CLI_PIN}" ; \
        fi ; \
        acp_dir=/opt/acp-node/lib/node_modules/@agentclientprotocol/claude-agent-acp ; \
        if [ -d "$acp_dir" ]; then \
            echo ">>> Refreshing proxy-addr to $PROXY_ADDR_PIN under claude-agent-acp (best-effort)" ; \
            ( cd "$acp_dir" && /opt/acp-node/bin/npm install --no-save --no-audit --no-fund "proxy-addr@${PROXY_ADDR_PIN}" ) \
                || echo ">>> WARN: proxy-addr refresh did not complete; scan gate will confirm final state." ; \
        fi ; \
        npm_for_pack="$(command -v npm || echo /usr/local/bin/npm)" ; \
        for pj in $(find / -path '*/node_modules/shell-quote/package.json' 2>/dev/null); do \
            d="$(dirname "$pj")" ; \
            echo ">>> Replacing bundled shell-quote in $d with ${SHELL_QUOTE_PIN} (clears CVE-2026-9277)" ; \
            tmp="$(mktemp -d)" ; \
            ( cd "$tmp" && "$npm_for_pack" pack --silent "shell-quote@${SHELL_QUOTE_PIN}" >/dev/null ) \
            && tar -xzf "$tmp"/shell-quote-*.tgz -C "$tmp" \
            && rm -rf "$d"/* \
            && cp -a "$tmp"/package/. "$d"/ \
            && rm -rf "$tmp" \
            || { echo "ERROR: failed to replace shell-quote in $d" >&2 ; exit 1 ; } ; \
        done ; \
        ( /usr/local/bin/npm cache clean --force >/dev/null 2>&1 || true ) ; \
        ( /opt/acp-node/bin/npm cache clean --force >/dev/null 2>&1 || true ) ; \
        rm -rf /root/.npm ; \
        echo ">>> Bundled npm CVE fixes applied." ; \
    fi
