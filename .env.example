# ============================================================================
# openhands-deployment — environment configuration
# ----------------------------------------------------------------------------
# Copy to `.env` (which is gitignored) and edit. Never commit `.env`.
#
#   cp .env.example .env
#   $EDITOR .env
# ============================================================================

# ---- Source images (upstream) ----------------------------------------------
# These are the upstream images the overlays patch on top of. They MUST exist
# in your local Docker cache before running ./scripts/build.sh. This repo
# does not pull them — that's the operator's responsibility.
#
#   openhands:latest            built from the OpenHands source repo
#                               (`make build`) or pulled from your fleet's
#                               registry. Override these two if your image
#                               lives elsewhere, e.g.
#                                   OPENHANDS_BASE_IMAGE=ghcr.io/myorg/openhands
#                                   OPENHANDS_BASE_TAG=2026.04.30
#   ghcr.io/openhands/agent-server:<version>-python
#                               obtain with:
#                                   docker pull ghcr.io/openhands/agent-server:1.58.0-python
# For the openhands app image, build from the newest OpenHands release tag
# (currently v1.31.0): `git -C /path/to/OpenHands checkout v1.31.0 && make build`.
OPENHANDS_BASE_IMAGE=openhands
OPENHANDS_BASE_TAG=latest

# agent-server 1.58.0-python is the newest published release (multi-arch
# amd64+arm64, Debian 13.4 / Trixie). It bundles openhands-sdk v1.58.0, which
# pins litellm>=1.93.0,<1.106 — see the litellm note below.
AGENT_SERVER_BASE_IMAGE=ghcr.io/openhands/agent-server
AGENT_SERVER_BASE_TAG=1.58.0-python

# ---- Local hardened image tags ---------------------------------------------
# What the overlay build produces locally. The compose file consumes these.
OPENHANDS_OUT_IMAGE=openhands
OPENHANDS_OUT_TAG=custom_base

AGENT_SERVER_OUT_IMAGE=agent-server
AGENT_SERVER_OUT_TAG=custom_base

# ---- Runtime knobs (consumed by compose/docker-compose.yml) ----------------
HOST_PORT=3000

# Where the openhands sandbox workspace lives on the HOST. Defaults to OUTSIDE
# this repo so agent-generated files (downloaded artifacts, generated code,
# anything the user pastes) can never accidentally end up staged or pushed.
# Leave commented out to use the compose-side default
# (${HOME}/openhands-deployment/workspace), or set an absolute path here.
# A relative value would be resolved against the directory you ran
# `docker compose` from — typically the repo root, which is what we want
# to avoid. Always prefer an absolute path.
#WORKSPACE_BASE=/Users/you/openhands-deployment/workspace

# ---- Scan policy -----------------------------------------------------------
# build.sh exits non-zero if the post-overlay image still has more than this
# many CRITICAL or HIGH CVEs. Default: zero criticals, highs unbounded.
POLICY_MAX_CRITICAL=0
POLICY_MAX_HIGH=

# ---- Optional: Python package upgrades inside the overlays -----------------
# Whitespace-separated pip specs. Leave empty if you only want OS patches.
# Example: PIP_UPGRADES_OPENHANDS="urllib3==2.5.0 cryptography==45.0.0"
#
# Recommended pins (Trivy CRITICAL review, 2026-10-22). These clear the
# fixable Critical Python CVEs in the current published images. Several are
# part of the emSign/eMudhra CA distrust: `certifi` and `uv` bundle their own
# CA stores that trust the compromised emSign root, and `anyio` has a TLS
# certificate-spoofing bug — none of which the Debian trust-store blacklist in
# the overlays can reach, so they MUST be bumped via pip as well.
#
# ===========================================================================
# litellm — READ THIS. Supply-chain + CVE picture (OSV, 2026-10-22):
#   * 1.107.0 is a MALICIOUS release (OSV MAL-2026-2144); also 1.82.7, 1.82.8.
#     1.107.0 has been YANKED from PyPI (installs 404). NEVER pin 1.107.x.
#   * CVE-2026-84377 (GHSA-3cv6-jpf6-8222): authenticated SSRF +
#     provider-credential exfiltration. Fixed on the 1.93 branch in 1.93.2
#     (mainline 1.88.6). So the old 1.84.0 pin does NOT cover it, and the
#     SDK lock target 1.93.0 is still vulnerable.
#   * openhands-sdk v1.58.0 constrains litellm>=1.93.0,<1.106 (1.106+ needs
#     mcp>=2, which breaks on mcp 1.x). So the secure, compatible window is
#     [1.93.2, 1.106).
#   => Pin litellm==1.93.2: fixes CVE-2026-84377, inside the SDK window, not a
#      malicious release. (1.105.x is the newest within the cap if you want
#      newer; do NOT cross 1.106, and never 1.107.0.)
#   Residual low-severity, no-fix-in-any-version litellm advisories
#   (CVE-2026-1277x / 1279x) are authenticated-proxy issues; OpenHands uses
#   litellm as a client library, so they do not apply to this usage.
# ===========================================================================
#
# openhands web image:
#   certifi    GHSA-6q48-6c7w-9gw2  emSign CA distrust            -> 2026.10.19
#   anyio      CVE-2026-63374       TLS cert spoofing (IDNA)      -> 4.14.2
#   litellm    CVE-2026-84377 (+49468)  SSRF/cred-exfil          -> 1.93.2
#   pillow     CVE-2026-112393/112403/112900/96639               -> 13.0.0
#   GitPython  CVE-2026-78676                                     -> 3.1.59
#   PyJWT      CVE-2026-102268                                    -> 2.14.0
#   jupyter_server CVE-2026-44727                                 -> 2.20.0
#     PIP_UPGRADES_OPENHANDS="certifi==2026.10.19 anyio==4.14.2 litellm==1.93.2 pillow==13.0.0 GitPython==3.1.59 PyJWT==2.14.0 jupyter_server==2.20.0 lxml==6.1.0"
#
# agent-server sandbox image (also bundles openhands-sdk -> litellm):
#   certifi    GHSA-6q48-6c7w-9gw2  emSign CA distrust            -> 2026.10.19
#   uv         GHSA-hq85-5cpj-mr62  emSign CA distrust            -> 0.13.4
#   anyio      CVE-2026-63374       TLS cert spoofing (IDNA)      -> 4.14.2
#   litellm    CVE-2026-84377           SSRF/cred-exfil          -> 1.93.2
#     PIP_UPGRADES_AGENT_SERVER="certifi==2026.10.19 uv==0.13.4 anyio==4.14.2 litellm==1.93.2"
#
# NOTE: `uv` is often installed as a standalone tool, not a venv dep; if the
# pip bump does not move it, replace the vendored /usr/local/bin/uv binary or
# `uv self update` in the overlay. Verify post-build with the Trivy scan.
# NOTE: pillow 12->13 is a MAJOR bump; review before shipping if you depend on
# Pillow's API inside the web image.
#
# These defaults are active so a fresh `cp .env.example .env` rebuilds clean.
# Set either to empty if you only want OS patches.
PIP_UPGRADES_OPENHANDS="certifi==2026.10.19 anyio==4.14.2 litellm==1.93.2 pillow==13.0.0 GitPython==3.1.59 PyJWT==2.14.0 jupyter_server==2.20.0 lxml==6.1.0"
PIP_UPGRADES_AGENT_SERVER="certifi==2026.10.19 uv==0.13.4 anyio==4.14.2 litellm==1.93.2"

# ---- Optional: slim variant build-args ------------------------------------
# These remove unused embedded stacks that contribute large CVE surfaces but
# no runtime functionality. See README "Slim variant" section.
#
# openhands web container — strip the VS Code extension build sandbox
# (~219MB of node_modules + compiled extension.js). The shipped .vsix
# stays intact, so end-users can still install it in their VS Code.
# STRIP_VSCODE_BUILD_ARTIFACTS=1
#
# agent-server sandbox — strip chromium + Mesa + X11 + TigerVNC + novnc.
# Disables the agent's browser tool but keeps everything else (shells,
# code edits, file ops, the embedded openvscode-server).
# STRIP_BROWSER_TOOLS=1
#
# agent-server sandbox — strip docker-in-docker (containerd.io, docker-ce*,
# runc, buildx, compose). Disables the agent's ability to run docker
# commands inside its sandbox, but most deployments don't need that since
# the agent itself is already running inside a container on the host's
# Docker. Required for 0 Critical when the upstream containerd statically
# links a vulnerable grpc.
# STRIP_DIND=1

# ---- LLM / app secrets (NEVER commit) --------------------------------------
# These are read by the OpenHands web container at runtime. Set them in `.env`,
# never inline in compose. Examples (uncomment + fill in your real `.env`):
#
# LLM_API_KEY=
# LLM_MODEL=anthropic/claude-sonnet-4
# LLM_BASE_URL=
